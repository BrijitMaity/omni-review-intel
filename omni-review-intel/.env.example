# ============================================================
# omni-review-intel — Environment Variables Template
# Copy this file to .env and fill in your keys.
# ============================================================

# ───────────────────────────────────────────────────────────
# REQUIRED FOR MVP
# ───────────────────────────────────────────────────────────

# Google Gemini API Key (get free tier at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# YouTube Data API v3 (get free at https://console.developers.google.com → Enable YouTube Data API v3)
YOUTUBE_API_KEY=your_youtube_data_api_key_here

# Reddit API (create an app at https://www.reddit.com/prefs/apps → script type)
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=omni-review-intel/1.0 by YourRedditUsername

# Tavily Web Search (get free tier at https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# ───────────────────────────────────────────────────────────
# OPTIONAL — Extended Platform Support
# ───────────────────────────────────────────────────────────

# SerpApi — Google Search + Google Lens reverse image search
# (free 100 searches/month at https://serpapi.com)
SERPAPI_KEY=your_serpapi_key_here

# Apify — Amazon reviews, Instagram, TikTok
# (get free credits at https://apify.com)
APIFY_API_KEY=your_apify_api_key_here

# Instagram — Optional sessionid cookie from logged-in browser for full comment pagination
# (without this, public Instagram posts return the initial preview batch only)
INSTAGRAM_SESSION_ID=your_instagram_sessionid_cookie_here

# Amazon — Optional logged-in Cookie header string for full /product-reviews/ pagination
# (without this, product pages extract embedded featured reviews when publicly shown)
AMAZON_COOKIE=

# Facebook — Optional Cookie header string (e.g. "c_user=...; xs=...") for logged-in comment access
FACEBOOK_COOKIE=

# ───────────────────────────────────────────────────────────
# OPTIONAL — Alternative LLM Provider
# ───────────────────────────────────────────────────────────

# Set to "openai" to switch from Gemini to OpenAI models
LLM_PROVIDER=gemini

# OpenAI key (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here

# ───────────────────────────────────────────────────────────
# PIPELINE TUNING (safe defaults shown)
# ───────────────────────────────────────────────────────────

MAX_DISCOVERED_URLS=15
MAX_COMMENTS_PER_URL=100
LLM_BATCH_SIZE=30
MAX_CONCURRENT_SCRAPES=5
REQUEST_TIMEOUT=30

# Gemini model names (override if needed)
GEMINI_FLASH_MODEL=gemini-2.0-flash
GEMINI_PRO_MODEL=gemini-2.0-flash
